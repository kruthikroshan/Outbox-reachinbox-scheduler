# --- Server ---
PORT=4000
FRONTEND_URL=http://localhost:3000
JWT_SECRET=change_me_super_secret
SESSION_SECRET=change_me_session_secret

# --- Postgres ---
DATABASE_URL=postgres://postgres:postgres@localhost:5432/reachinbox

# --- Redis (BullMQ + rate limit counters) ---
REDIS_URL=redis://localhost:6379

# --- Ethereal (fake SMTP for testing) ---
# Leave blank to auto-create a fresh Ethereal test account on boot (logged to console).
ETHEREAL_USER=
ETHEREAL_PASS=

# --- Scheduling / rate limiting (all configurable, no hardcoding) ---
WORKER_CONCURRENCY=5
MIN_DELAY_BETWEEN_EMAILS_MS=2000
MAX_EMAILS_PER_HOUR=200
MAX_EMAILS_PER_HOUR_PER_SENDER=50

# --- Google OAuth (create your own credentials at console.cloud.google.com) ---
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_CALLBACK_URL=http://localhost:4000/api/auth/google/callback

# --- Slack OAuth (create your own app at api.slack.com/apps) ---
SLACK_CLIENT_ID=
SLACK_CLIENT_SECRET=
SLACK_REDIRECT_URI=http://localhost:4000/api/slack/oauth/callback

# --- Elasticsearch (optional; search endpoints no-op gracefully if unset) ---
ELASTICSEARCH_URL=
